# Copie para .env (não versionar .env com valores reais).
UI_AUTH_USER=admin
UI_AUTH_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_REAL_HASH
UI_SESSION_SECRET=replace-with-32-plus-random-characters
SESSION_TTL_SECONDS=900

# URL pública para forçar uso de HTTPS no reverse proxy
PUBLIC_BASE_URL=https://example.com
